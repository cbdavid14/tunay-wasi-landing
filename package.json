{
  "name": "tunay-wasi-landing",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:qa": "vite --mode qa",
    "build": "tsc --noEmit && vite build",
    "build:clientes": "VITE_APP_TARGET=clientes vite build --outDir dist/clientes",
    "build:caficultores": "VITE_APP_TARGET=caficultores vite build --outDir dist/caficultores",
    "build:negocios": "VITE_APP_TARGET=mayoristas vite build --outDir dist/negocios",
    "build:mvp": "VITE_APP_TARGET=one vite build --outDir dist/mvp",
    "build:all": "tsc --noEmit && npm run build:clientes && npm run build:caficultores && npm run build:negocios && npm run build:mvp",
    "preview": "vite preview",
    "seed": "tsx scripts/seed.ts",
    "seed:force": "tsx scripts/seed.ts --force",
    "seed:one": "VITE_USE_EMULATOR=true tsx src/one/seed/seed-one.ts",
    "seed:one:qa": "FIREBASE_PROJECT=alpaso-app tsx src/one/seed/seed-one.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "e2e": "playwright test",
    "kyc:demo": "firebase emulators:exec --config firebase.e2e.json --only firestore,auth --project demo-kyc-e2e \"tsx e2e-kyc/demo.ts\"",
    "e2e:kyc": "E2E_PUERTO=5198 firebase emulators:exec --config firebase.e2e-test.json --only firestore,auth --project demo-kyc-e2e \"playwright test -c playwright.kyc.config.ts\"",
    "e2e:f01": "playwright test --grep \"\\[F-01\\]\"",
    "e2e:f02": "playwright test --grep \"\\[F-02\\]\"",
    "e2e:f03": "playwright test --grep \"\\[F-03\\]\"",
    "e2e:f04": "playwright test --grep \"\\[F-04\\]\"",
    "e2e:f05": "playwright test --grep \"\\[F-05\\]\"",
    "e2e:f06": "playwright test --grep \"\\[F-06\\]\"",
    "e2e:f07": "playwright test --grep \"\\[F-07\\]\"",
    "e2e:f08": "playwright test --grep \"\\[F-08\\]\"",
    "e2e:f09": "playwright test --grep \"\\[F-09\\]\"",
    "e2e:f10": "playwright test --grep \"\\[F-10\\]\"",
    "e2e:f11": "playwright test --grep \"\\[F-11\\]\"",
    "e2e:f12": "playwright test --grep \"\\[F-12\\]\"",
    "e2e:f13": "playwright test --grep \"\\[F-13\\]\"",
    "e2e:alta": "playwright test --grep \"@alta\"",
    "e2e:media": "playwright test --grep \"@media\""
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@tanstack/react-query": "^5.80.5",
    "firebase": "^12.8.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^3.1.0",
    "zod": "^3.24.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.2.1",
    "firebase-admin": "^13.10.0",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3",
    "vite": "^5.1.0"
  }
}
