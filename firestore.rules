rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function clienteCreateKeys() {
      return ['uid','nombre','displayName','email','telefono','codigoReferidoUsado',
              'emailVerified','rol','estado','puntos','nivel','pedidosTotales',
              'createdAt','updatedAt','lastLoginAt'];
    }

    function clienteUpdateKeys() {
      return ['nombre','displayName','email','telefono','codigoReferidoUsado',
              'emailVerified','estado','updatedAt','lastLoginAt'];
    }

    match /productos/{id} {
      allow read: if true;
      allow update: if true;
      allow create, delete: if true;
    }
    match /caficultores/{id} {
      allow read: if true;
      allow write: if true;
    }
    match /configurations/{id} {
      allow read: if true;
      allow write: if true;
    }
    match /clientes/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(clienteCreateKeys())
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.rol == 'cliente';
      allow update: if isOwner(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.rol == resource.data.rol
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(clienteUpdateKeys());
      allow delete: if false;
    }
    match /pedidos/{id} {
      allow read: if request.auth != null;
      allow create: if true;
      allow update: if request.auth != null;
      allow delete: if false;
    }
    match /waitlist-caficultores/{id} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }
    match /waitlist-b2c/{id} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }
    match /waitlist-b2b/{id} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }
    match /waitlist-b2b-tunay-wasi/{id} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }
    match /waitlist-b2c-tunay-wasi/{id} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }
    match /solicitudes_b2b/{id} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }
    match /contactos/{id} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }
    match /microlotesLanding/{id} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
