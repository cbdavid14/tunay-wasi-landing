 rules_version = '2';
  service cloud.firestore {
    match /databases/{database}/documents {

      // ── Admin con email verificado (SEC-03) — definida primero para reusar en todo el archivo ──
      function esAdminVerificado() {
        return request.auth != null && request.auth.token.email_verified == true &&
               (request.auth.token.email.matches('.*@tunaywasi\\.pe') ||
                request.auth.token.email == 'tunaywasi@gmail.com');
      }

      match /productos/{id} {
        allow read: if true;
        allow update: if request.auth != null
          ? request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stockKg', 'stockReservedKg'])
          : request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stockReservedKg']);
        allow create, delete: if false;
      }

      match /caficultores/{id} {
        allow read: if true;
        allow write: if false;
      }

      match /configurations/{id} {
        allow read: if true;
        allow write: if false;
      }

      match /microlotesLanding/{id} {
        allow read: if true;
        allow write: if false;
      }

      match /pedidos/{id} {
        allow read: if request.auth != null;
        allow create: if true;
        allow update: if request.auth != null;
        allow delete: if false;
      }

      match /waitlist-caficultores/{id} {
        allow read: if false;
        allow create: if true;
        allow update, delete: if false;
      }

      match /waitlist-b2c/{id} {
        allow read: if true;
        allow create: if true;
        allow update, delete: if false;
      }

      match /waitlist-b2b/{id} {
        allow read: if true;
        allow create: if true;
        allow update, delete: if false;
      }

      match /solicitudes_b2b/{id} {
        allow read: if true;
        allow create: if true;
        allow update, delete: if false;
      }

      match /contactos/{id} {
        allow read: if false;
        allow create: if true;
        allow update, delete: if false;
      }

      // ── ONE (portal caficultor/negocio) ──

      // ── SEC-01/02: one_usuarios ──────────────────────────────────────────────
      // Lectura pública: solo campos del catálogo (seller). Datos sensibles (DNI,
      // fotos KYC, tokens FCM, empresa.*) requieren ser el propio dueño o admin.
      // Escritura: el usuario no puede cambiar rol, scoreConfianza ni aprobación.
      match /one_usuarios/{uid} {
        function esDueno() { return request.auth != null && request.auth.uid == uid; }
        function camposEscrituraSeguros() {
          return !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['rol', 'scoreConfianza', 'totalCalificaciones',
                     'empresa.estadoAprobacion', 'empresa.aprobadoPor',
                     'empresa.aprobadoAt', 'empresa.motivoRechazo',
                     'fotoDniUrl', 'fotoSelfieUrl', 'fcmTokens']);
        }
        // get: dueño, admin, o perfil seller sin datos KYC (catálogo público)
        allow get: if esDueno() || esAdminVerificado() ||
                      (resource.data.rol == 'seller' &&
                       !resource.data.keys().hasAny(['fotoDniUrl', 'fotoSelfieUrl']));
        allow list: if request.auth != null;
        // KYC (F-03): el dueño solo puede quedar "en revisión"; nunca aprobarse ni activarse.
        function kycDelDueno() {
          let nuevo = request.resource.data;
          let antes = resource == null ? {} : resource.data;
          return (nuevo.get('estadoKyc', null) == antes.get('estadoKyc', null) ||
                  (antes.get('estadoKyc', null) == null && nuevo.get('estadoKyc', null) == 'PENDING_REVIEW')) &&
                 nuevo.get('kycRevisionId', null) == antes.get('kycRevisionId', null) &&
                 (nuevo.get('caficultor', {}).get('activo', false) != true ||
                  antes.get('caficultor', {}).get('activo', false) == true);
        }
        // KYC (F-03): el admin solo cambia el estado, y dejando el registro de auditoría en la misma operación.
        function decisionKycDelAdmin() {
          let nuevo = request.resource.data;
          let revision = /databases/$(database)/documents/one_kyc_revisiones/$(nuevo.kycRevisionId);
          return esAdminVerificado() &&
                 nuevo.diff(resource.data).affectedKeys().hasOnly(['estadoKyc', 'caficultor', 'kycRevisionId', 'updatedAt']) &&
                 nuevo.get('caficultor', {}).diff(resource.data.get('caficultor', {})).affectedKeys().hasOnly(['activo']) &&
                 nuevo.estadoKyc in ['ACTIVO', 'RECHAZADO'] &&
                 nuevo.kycRevisionId != resource.data.get('kycRevisionId', null) &&
                 !exists(revision) &&
                 getAfter(revision).data.uid == uid &&
                 getAfter(revision).data.resultado == (nuevo.estadoKyc == 'ACTIVO' ? 'APROBADO' : 'RECHAZADO');
        }
        allow create: if esDueno() &&
                         request.resource.data.uid == uid &&
                         !request.resource.data.keys().hasAny(
                           ['scoreConfianza', 'totalCalificaciones',
                            'empresa.estadoAprobacion', 'empresa.aprobadoPor']) &&
                         (request.resource.data.get('rol', '') != 'admin' || esAdminVerificado()) &&
                         kycDelDueno();
        allow update: if (esDueno() && camposEscrituraSeguros() && kycDelDueno()) || decisionKycDelAdmin();
        allow delete: if false;
      }

      // ── KYC: historial de revisiones (job nocturno y admin). Solo admins; nadie edita ni borra.
      match /one_kyc_revisiones/{revisionId} {
        allow read: if esAdminVerificado();
        allow create: if esAdminVerificado() &&
                         request.resource.data.origen == 'ADMIN' &&
                         request.resource.data.adminUid == request.auth.uid &&
                         request.resource.data.adminEmail == request.auth.token.email &&
                         request.resource.data.fecha == request.time &&
                         request.resource.data.resultado in ['APROBADO', 'RECHAZADO'] &&
                         ((request.resource.data.resultado == 'APROBADO' &&
                           request.resource.data.criteriosPendientes.size() == 0) ||
                          request.resource.data.mensaje.size() >= 10) &&
                         getAfter(/databases/$(database)/documents/one_usuarios/$(request.resource.data.uid))
                           .data.kycRevisionId == revisionId;
        allow update, delete: if false;
      }

      // ── SEC-PRD/05: one_productos ─────────────────────────────────────────────
      // Solo el caficultor dueño puede crear/modificar sus productos.
      // No se pueden modificar precios sin ser el dueño — impide manipulación de precio en checkout.
      match /one_productos/{id} {
        allow read: if true;  // catálogo público
        allow create: if request.auth != null &&
                         request.resource.data.caficultorId == request.auth.uid;
        allow update: if request.auth != null &&
                         resource.data.caficultorId == request.auth.uid;
        allow delete: if request.auth != null &&
                         resource.data.caficultorId == request.auth.uid;
      }

      match /one_pedidos/{id} {
        allow read, write: if request.auth != null;
        // ── SEC-11: mensajes — solo las partes del pedido ─────────────────────
        match /mensajes/{mensajeId} {
          allow read, write: if request.auth != null &&
                                (get(/databases/$(database)/documents/one_pedidos/$(id)).data.buyerId == request.auth.uid ||
                                 get(/databases/$(database)/documents/one_pedidos/$(id)).data.sellerId == request.auth.uid ||
                                 esAdminVerificado());
        }
      }

      match /one_caficultores/{id} {
        allow read: if true;
        allow write: if false;
      }

      match /one_kits/{id} {
        allow read, write: if request.auth != null;
      }

      match /one_menus/{id} {
        allow read, write: if request.auth != null;
      }

      match /one_mensajes/{id} {
        allow read, write: if request.auth != null;
      }

      // ── SEC-09: one_calificaciones_* ──────────────────────────────────────────
      // Solo el negocio que realizó el pedido puede crear la calificación.
      // No se puede modificar ni borrar (una vez enviada es definitiva).
      match /one_calificaciones_caficultor/{id} {
        allow read: if true;
        allow create: if request.auth != null &&
                         request.resource.data.negocioId == request.auth.uid;
        allow update, delete: if false;
      }

      match /one_calificaciones_cafeteria/{id} {
        allow read: if true;
        allow create: if request.auth != null &&
                         request.resource.data.negocioId == request.auth.uid;
        allow update, delete: if false;
      }

      match /one_solicitudes_caficultor/{id} {
        allow read: if false;
        allow create: if true;
        allow update, delete: if false;
      }

      match /one_reclamos/{id} {
        allow create: if request.auth != null &&
                         request.resource.data.negocioId == request.auth.uid;
        allow read: if request.auth != null &&
                       (resource.data.negocioId == request.auth.uid ||
                        resource.data.caficultorId == request.auth.uid);
        allow update, delete: if request.auth != null &&
                                  request.auth.token.email.matches('.*@tunaywasi\\.pe');
      }

      // ── one_cotizaciones ─────────────────────────────────────────────────────

      match /one_cotizaciones/{cotizacionId} {
        allow create: if request.auth != null &&
                         request.resource.data.negocioId == request.auth.uid;
        allow read: if request.auth != null &&
                       (resource.data.negocioId == request.auth.uid ||
                        resource.data.caficultorId == request.auth.uid ||
                        request.auth.token.email.matches('.*@tunaywasi\\.pe') ||
                        request.auth.token.email == 'tunaywasi@gmail.com');
        allow update: if request.auth != null &&
                         (resource.data.negocioId == request.auth.uid ||
                          resource.data.caficultorId == request.auth.uid ||
                          request.auth.token.email.matches('.*@tunaywasi\\.pe') ||
                          request.auth.token.email == 'tunaywasi@gmail.com');
        allow delete: if request.auth != null &&
                         (request.auth.token.email.matches('.*@tunaywasi\\.pe') ||
                          request.auth.token.email == 'tunaywasi@gmail.com');
      }

      // ── one_documentos — índice de unicidad DNI/RUC (REG-01 → REG-03) ───────
      // Clave = DNI_B2C_<8>, DNI_SELLER_<8> o RUC_<11>. El RUC de cooperativa no se indexa.
      // create solo si la clave NO existe → unicidad atómica. update solo por el mismo dueño
      // (reintentos idempotentes). Sin lectura pública: no se puede consultar si un DNI existe.
      match /one_documentos/{clave} {
        function camposValidos() {
          return request.resource.data.keys().hasOnly(['uid', 'rol', 'tipo', 'createdAt']) &&
                 request.resource.data.uid == request.auth.uid;
        }
        function esAdmin() {
          return request.auth != null &&
                 (request.auth.token.email.matches('.*@tunaywasi\\.pe') ||
                  request.auth.token.email == 'tunaywasi@gmail.com');
        }
        allow create: if request.auth != null && camposValidos() &&
                         clave.matches('^(DNI_B2C_[0-9]{8}|DNI_SELLER_[0-9]{8}|RUC_(10|15|17|20)[0-9]{9})$');
        allow update: if request.auth != null && resource.data.uid == request.auth.uid && camposValidos();
        allow delete: if (request.auth != null && resource.data.uid == request.auth.uid) || esAdmin();
        allow read: if esAdmin();
      }

      // ── Analytics propia (src/one/analytics.ts) — iter.16 ─────────────────────────
      // Solo CREAR eventos con esquema fijo y sin PII. Nadie actualiza ni borra; solo el admin lee.
      // Antes no había regla → el catch-all rechazaba TODOS los eventos en silencio.
      match /one_analytics/{id} {
        function d() { return request.resource.data; }
        allow create: if d().keys().hasOnly([
              'sessionId', 'userId', 'rolUsuario', 'evento', 'url', 'fecha', 'ts',
              'userAgent', 'lang', 'screen', 'mobile', 'timezone',
              'productoId', 'productoNombre', 'caficultorId', 'cantidadKg', 'totalCents', 'itemCount',
              'metodoPago', 'pedidoId', 'pasoDesde', 'mensaje',
              'onboardingId', 'flujo', 'puerta', 'paso', 'origen', 'metodo', 'codigo'])
          && d().keys().hasAll(['sessionId', 'userId', 'evento', 'url', 'fecha', 'ts'])
          && d().evento in ['catalogo_visto', 'producto_visto', 'carrito_agregado', 'carrito_quitado',
              'checkout_intentado', 'login_requerido', 'login_iniciado', 'login_exitoso',
              'registro_completado', 'checkout_inicio', 'checkout_paso2', 'checkout_confirmado',
              'portal_negocio_visto', 'portal_caficultor_visto', 'error_capturado',
              'onboarding_paso', 'onboarding_error']
          && d().ts == request.time
          && d().userId is string
          && (d().userId == 'anonimo' || (request.auth != null && d().userId == request.auth.uid))
          && d().url is string && d().url.size() <= 300
          && (!('mensaje' in d()) || (d().mensaje is string && d().mensaje.size() <= 500))
          && (!('userAgent' in d()) || (d().userAgent is string && d().userAgent.size() <= 150));
        allow read: if esAdminVerificado();
        allow update, delete: if false;
      }

      // ── Cuentas Auth sin perfil en one_usuarios (registro abandonado) — iter.16 ──
      // Las escribe la Lambda `lambda/onboarding-incompletos` con Admin SDK (salta reglas).
      match /one_onboarding_incompletos/{uid} {
        allow read: if esAdminVerificado();
        allow write: if false;
      }

      match /ubigeos/{id} {
        allow read: if true;
        allow write: if false;
      }

      match /{document=**} {
        allow read, write: if false;
      }
    }
  }
