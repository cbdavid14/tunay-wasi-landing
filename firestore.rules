rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Lectura pública para catálogo y configuraciones
    match /productos/{id} {
      allow read: if true;
      // Checkout (no auth): solo reservar stock
      // Admin (auth): confirmar pago → decrementar stockKg + stockReservedKg
      allow update: if request.auth != null
        ? request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stockKg', 'stockReservedKg'])
        : request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stockReservedKg']);
      allow create, delete: if false;
    }
    match /caficultores/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /configurations/{id} {
      allow read: if true;
      allow write: if false;
    }

    // Pedidos: crear (checkout), leer/actualizar (admin)
    match /pedidos/{id} {
      allow read: if request.auth != null;
      allow create: if true;
      allow update: if request.auth != null;
      allow delete: if false;
    }

    // Waitlist caficultores
    match /waitlist-caficultores/{id} {
      allow read: if false;
      allow create: if true;
      allow update, delete: if false;
    }

    // Waitlist B2C (lista prioritaria — web + lead form Facebook)
    match /waitlist-b2c/{id} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }

    // Waitlist B2B (negocios — tostadoras, cafeterías, mayoristas)
    match /waitlist-b2b/{id} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }

    // Todo lo demás bloqueado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
