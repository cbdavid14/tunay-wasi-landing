rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // Lee el rol desde mkt_usuarios.
    // NOTA: No llamar desde reglas de mkt_usuarios — causaría recursión circular.
    function rol() {
      return get(/databases/$(database)/documents/mkt_usuarios/$(uid())).data.rol;
    }

    function isCaficultor() {
      return isSignedIn() && rol() == 'caficultor';
    }

    function isCafeteria() {
      return isSignedIn() && rol() == 'cafeteria';
    }

    function isLaboratorio() {
      return isSignedIn() && rol() == 'laboratorio';
    }

    // ── mkt_usuarios / usuarios_perfil ────────────────────────────────────────
    // Sin llamar a rol() — evita recursión circular.
    // El admin usa Admin SDK y bypasea estas reglas.

    match /usuarios_perfil/{userId} {
      allow read, write: if isSignedIn() && uid() == userId;
    }

    match /mkt_usuarios/{userId} {
      allow read, write: if isSignedIn() && uid() == userId;
    }

    // ── mkt_lotes ─────────────────────────────────────────────────────────────
    // Lectura pública. Caficultor crea/edita sus lotes.
    // Cafetería y laboratorio pueden actualizar (solicitudes, catación).

    match /mkt_lotes/{loteId} {
      allow read: if true;

      allow create: if isCaficultor()
        && request.resource.data.caficultorId == uid();

      allow update: if (isCaficultor() && resource.data.caficultorId == uid())
        || isCafeteria()
        || isLaboratorio();

      allow delete: if false;
    }

    // ── mkt_caficultores ──────────────────────────────────────────────────────

    match /mkt_caficultores/{caficultorId} {
      allow read: if true;
      allow write: if isCaficultor() && uid() == caficultorId;
    }

    // ── mkt_laboratorios ──────────────────────────────────────────────────────

    match /mkt_laboratorios/{labId} {
      allow read: if true;
      allow create: if isLaboratorio() && uid() == labId;
      allow update: if isLaboratorio() && uid() == labId;
      allow delete: if false;
    }

    // ── mkt_solicitudes_muestra ───────────────────────────────────────────────

    match /mkt_solicitudes_muestra/{solicitudId} {
      allow read: if isSignedIn();

      allow create: if isCafeteria();

      allow update: if isSignedIn() && (
        resource.data.tostadoraId == uid()
        || isCaficultor()
        || isLaboratorio()
      );

      allow delete: if false;
    }

    // ── mkt_solicitudes_certificacion ─────────────────────────────────────────

    match /mkt_solicitudes_certificacion/{solicitudId} {
      allow read: if isSignedIn() && (
        resource.data.caficultorId == uid()
        || resource.data.laboratorioId == uid()
      );

      allow create: if isCaficultor()
        && request.resource.data.caficultorId == uid();

      allow update: if isSignedIn() && (
        resource.data.laboratorioId == uid()
        || resource.data.caficultorId == uid()
      );

      allow delete: if false;
    }

    // ── mkt_pedidos ───────────────────────────────────────────────────────────
    // Admin y Cloud Functions usan Admin SDK — bypasean estas reglas.

    match /mkt_pedidos/{pedidoId} {
      allow read: if isSignedIn() && (
        resource.data.tostadoraId == uid()
        || resource.data.caficultorId == uid()
        || (isLaboratorio() && resource.data.laboratorioId == uid())
      );

      allow create: if isCafeteria()
        && request.resource.data.tostadoraId == uid();

      // La cafetería puede confirmar recepción: solo transición en_transito → entregado
      allow update: if isCafeteria()
        && resource.data.tostadoraId == uid()
        && (
          // Confirmar recepción: en_transito → entregado
          (resource.data.logisticaStatus == 'en_transito'
            && request.resource.data.logisticaStatus == 'entregado'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['logisticaStatus', 'updatedAt']))
          ||
          // Subir voucher: pendiente → en_revision
          (resource.data.pagoStatus == 'pendiente'
            && request.resource.data.pagoStatus == 'en_revision'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pagoStatus', 'comprobanteUrl', 'voucherSubidoAt', 'updatedAt']))
        );

      allow delete: if false;
    }

    // ── mkt_tostadoras ────────────────────────────────────────────────────────

    match /mkt_tostadoras/{docId} {
      allow read: if true;
      allow write: if isSignedIn() && uid() == docId;
    }

    // ── mkt_notificaciones ────────────────────────────────────────────────────
    // Cada usuario solo lee y marca como leídas sus propias notificaciones.
    // Cualquier usuario autenticado puede crear notifs para otro (saveNotif).

    match /mkt_notificaciones/{userId}/items/{notifId} {
      allow read: if isSignedIn() && uid() == userId;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && uid() == userId;
      allow delete: if false;
    }

  }
}
